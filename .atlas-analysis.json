  "keyFeatures": [
    "P2P inward and outward remittance (DigiRemit)",
    "High-volume bulk outbound remittance processing (DigiForex)",
    "Bulk inbound remittance from global MTOs (LastMile)",
    "Cross-border SME business payments (BizPay)",
    "End-to-end FX deal booking and utilization (DigiBureau)",
    "Unified exchange house / MTO platform (Ex-Core)",
    "Global exchange house acceleration platform (ConnectX)",
    "100+ pre-tested integrations across payment ecosystem",
    "Inbuilt 4-Eye and 6-Eye compliance workflows",
    "SWIFT automation and multi-corridor support",
    "30-day deployment with omnichannel architecture",
    "Fortress-level AML, KYC, and sanctions compliance"
  ],
  "publicApiSurface": [
    "POST /transactions — create remittance transaction",
    "GET /transactions/{id} — retrieve transaction details",
    "DELETE /transactions/{id} — cancel transaction",
    "GET /transactions/{id}/status — poll transaction status",
    "GET /fx/rates — fetch live FX exchange rates",
    "POST /fx/deals — book an FX deal",
    "POST /fx/deals/{id}/utilize — utilize a booked FX deal",
    "POST /compliance/kyc — submit KYC verification",
    "POST /compliance/aml — run AML screening",
    "POST /compliance/sanctions — run sanctions check",
    "POST /webhooks — register webhook endpoint",
    "GET /webhooks/events — list webhook event types"
  ]
